# 학교 AI API 키 (BAZE > API Gateway에서 발급). 이 파일 말고 .env에 넣을 것
GATEWAY_API_KEY=
GATEWAY_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
ANTHROPIC_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway/claude
