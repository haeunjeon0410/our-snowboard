# 학교 AI API 키 (BAZE > API Gateway에서 발급). 이 파일 말고 .env에 넣을 것
GATEWAY_API_KEY=
GATEWAY_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
ANTHROPIC_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway/claude
# 읽어 주기 AI 목소리 (선택). 공개 서버에서는 하루 문장 수 상한을 두는 것이 좋다
# TTS_MODEL=gemini-3.1-flash-tts-preview
# DAILY_TTS_LIMIT=5000   (기본 5000, 0이면 제한 없음)
# AI 호출 기록 (선택). 둘 다 있을 때만 켜지고, 강의 내용은 가려서 보낸다 (기능·버전·토큰·시간·검증 점수만).
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_SEND_CONTENT=1   (내용까지 보려면)
